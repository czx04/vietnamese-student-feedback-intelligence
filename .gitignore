# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage, lint and type-check caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Python build and packaging output
build/
dist/
*.egg-info/

# Frontend dependencies and build output
node_modules/
frontend/dist/

# Secrets and local configuration
.env
.env.*
!.env.example

# Trained models and checkpoints
# Keep the two small baseline models so a fresh clone can run immediately.
artifacts/*
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
!artifacts/sentiment_model.joblib
!artifacts/topic_model.joblib

# Generated evaluation reports
reports/*

# Local documentation and guides
*.md

# Large local result archives
*.tar

# Local utility scripts
scripts/

# Logs and temporary files
*.log
*.db
tmp/
temp/

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
